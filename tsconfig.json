{
  "extends": "$app/tsconfig",
  "files": [],
  "references": [{ "path": "./tsconfig.app.json" }, { "path": "./tsconfig.node.json" }],
  "compilerOptions": {
    "baseUrl": ".",
    "types": ["$app/types", "node"],
    "paths": {
      "$app/*": ["./.svelte-kit/types/ambient.d.ts"],
      "$env/*": ["./.svelte-kit/types/ambient.d.ts"],
      "$lib": ["./src/lib"],
      "$lib/*": ["./src/lib/*"],
      "@/*": ["./src/*"]
    }
  }
}
